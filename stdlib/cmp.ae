fn abs(x: i32) -> i32 {
    if x < 0 { return 0 - x; }
    return x;
}

fn sign(x: i32) -> i32 {
    if x < 0 { return 0 - 1; }
    if x > 0 { return 1; }
    return 0;
}

fn main() -> i32 {
    print_i32(abs(0 - 8));
    print_i32(sign(0 - 3));
    print_i32(sign(0));
    print_i32(sign(4));
    return 0;
}
