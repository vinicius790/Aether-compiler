// Reference routines. Aether 0.2 has no `mod`/`use`; copy into the program.

fn abs(x: i32) -> i32 {
    if x < 0 { return 0 - x; }
    return x;
}

fn min(a: i32, b: i32) -> i32 {
    if a < b { return a; }
    return b;
}

fn max(a: i32, b: i32) -> i32 {
    if a > b { return a; }
    return b;
}

fn clamp(x: i32, lo: i32, hi: i32) -> i32 {
    return max(lo, min(hi, x));
}

fn main() -> i32 {
    print_i32(abs(0 - 5));
    print_i32(min(3, 9));
    print_i32(max(3, 9));
    print_i32(clamp(15, 0, 10));
    return 0;
}
