// Reference routines. Import with `use "stdlib/math.ae";` (the API is `pub`) or
// run this file directly: it has its own `main`.

pub fn abs(x: i32) -> i32 {
    if x < 0 { return 0 - x; }
    return x;
}

pub fn min(a: i32, b: i32) -> i32 {
    if a < b { return a; }
    return b;
}

pub fn max(a: i32, b: i32) -> i32 {
    if a > b { return a; }
    return b;
}

pub fn clamp(x: i32, lo: i32, hi: i32) -> i32 {
    return max(lo, min(hi, x));
}

fn main() -> i32 {
    print_i32(abs(0 - 5));
    print_i32(min(3, 9));
    print_i32(max(3, 9));
    print_i32(clamp(15, 0, 10));
    return 0;
}
