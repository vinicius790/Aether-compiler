// Aether prelude: helper routines meant to be *included*, not run.
//
//     aether run game.ae --include stdlib/prelude.ae
//     AETHER_INCLUDE=stdlib/prelude.ae aether run game.ae
//
// Every function is `pub`; there is no `fn main` here. `abs`, `min`, `max` and `clamp` are built-ins
// (see stdlib/math.ae for the reference versions), so they are not defined.

// Linear interpolation: a at t = 0, b at t = 1.
pub fn lerp(a: f64, b: f64, t: f64) -> f64 {
    return a + (b - a) * t;
}

// -1, 0 or 1.
pub fn sign(x: i32) -> i32 {
    if x < 0 { return 0 - 1; }
    if x > 0 { return 1; }
    return 0;
}

pub fn is_even(x: i32) -> bool {
    return x % 2 == 0;
}

// Greatest common divisor (Euclid); never negative.
pub fn gcd(a: i32, b: i32) -> i32 {
    let mut x = a;
    let mut y = b;
    if x < 0 { x = 0 - x; }
    if y < 0 { y = 0 - y; }
    while y != 0 {
        let t = x % y;
        x = y;
        y = t;
    }
    return x;
}

pub fn clamp_f64(x: f64, lo: f64, hi: f64) -> f64 {
    if x < lo { return lo; }
    if x > hi { return hi; }
    return x;
}

// Wrap i into 0..n (n > 0), so -1 becomes n - 1.
pub fn wrap_index(i: i32, n: i32) -> i32 {
    let r = i % n;
    if r < 0 { return r + n; }
    return r;
}

// 0 + 1 + ... + (n - 1).
pub fn sum_to(n: i32) -> i32 {
    let mut s = 0;
    let mut i = 0;
    while i < n {
        s = s + i;
        i = i + 1;
    }
    return s;
}
