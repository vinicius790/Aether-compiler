// Aether stdlib: 2-D vectors over f64. Meant to be imported, not run:
//
//     use "stdlib/vec2.ae";        // from the repo root
//     use "../stdlib/vec2.ae";     // from examples/
//
// There is no `fn main` here. The API is `pub`: an item without `pub` would be
// private to this file (error E0281 elsewhere). Names are prefixed with `vec2_` because the
// namespace is flat (see docs/language.md, "Módulos").

pub struct Vec2 {
    x: f64,
    y: f64,
}

pub fn vec2_new(x: f64, y: f64) -> Vec2 {
    return Vec2 { x: x, y: y };
}

pub fn vec2_add(a: Vec2, b: Vec2) -> Vec2 {
    return Vec2 { x: a.x + b.x, y: a.y + b.y };
}

pub fn vec2_sub(a: Vec2, b: Vec2) -> Vec2 {
    return Vec2 { x: a.x - b.x, y: a.y - b.y };
}

pub fn vec2_scale(v: Vec2, k: f64) -> Vec2 {
    return Vec2 { x: v.x * k, y: v.y * k };
}

pub fn vec2_dot(a: Vec2, b: Vec2) -> f64 {
    return a.x * b.x + a.y * b.y;
}

// Euclidean length, via the `sqrt` built-in.
pub fn vec2_length(v: Vec2) -> f64 {
    return sqrt(vec2_dot(v, v));
}
